@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const MAX_SIZE = 10 * 1024 * 1024;
            const MAX_SIGNERS = 10;

            let fileValidationVersion = 0;
            let selectedFileIsValidPdf = false;

            const form = document.getElementById("signingForm");

            const fileInput =
                document.getElementById("UploadedFile");

            const uploadZone =
                document.getElementById("uploadZone");

            const browseButton =
                document.getElementById("chooseFileButton");

            const selectedFile =
                document.getElementById("selectedFile");

            const selectedFileName =
                document.getElementById("selectedFileName");

            const fileError =
                document.getElementById("fileError");

            const pendingUploadToken =
                document.getElementById("PendingUploadToken");

            const pendingUploadFileName =
                document.getElementById("PendingUploadFileName");

            const signerCountSelect =
                document.getElementById("signerCount");

            const signersContainer =
                document.getElementById("signersContainer");

            const signerTemplate =
                document.getElementById("signerTemplate");

            const signingOrder =
                document.getElementById("SigningOrderMode");

            const requestDate =
                document.getElementById("RequestDate");

            const documentType =
                document.getElementById("DocumentType");

            const recipientCompany =
                document.getElementById("RecipientCompany");

            const recipientEmail =
                document.getElementById("RecipientEmail");

            const emailSubject =
                document.getElementById("EmailSubject");

            const reviewFile =
                document.getElementById("reviewFile");

            const reviewDate =
                document.getElementById("reviewDate");

            const reviewType =
                document.getElementById("reviewType");

            const reviewCompany =
                document.getElementById("reviewCompany");

            const reviewRecipientEmail =
                document.getElementById("reviewRecipientEmail");

            const reviewSignerCount =
                document.getElementById("reviewSignerCount");

            const reviewSigningOrder =
                document.getElementById("reviewSigningOrder");

            const reviewSigners =
                document.getElementById("reviewSigners");

            const reviewSubject =
                document.getElementById("reviewSubject");

            const steps = [
                document.getElementById("progressStep1"),
                document.getElementById("progressStep2"),
                document.getElementById("progressStep3"),
                document.getElementById("progressStep4"),
                document.getElementById("progressStep5")
            ];

            // ==================================================
            // GENERAL HELPERS
            // ==================================================

            function valueOf(element) {
                return element ? element.value.trim() : "";
            }

            function hasValue(element) {
                return valueOf(element) !== "";
            }

            function hasPendingUpload() {

                return !!(
                    pendingUploadToken &&
                    pendingUploadFileName &&
                    pendingUploadToken.value.trim() !== "" &&
                    pendingUploadFileName.value.trim() !== ""
                );
            }

            function validPdfSelected() {
                return selectedFileIsValidPdf || hasPendingUpload();
            }

            // ==================================================
            // PDF CONTENT VALIDATION
            // ==================================================

            async function getPdfValidationError(file) {

                if (!file) {
                    return "Please select a PDF document.";
                }

                if (file.size === 0) {
                    return "The selected file is empty.";
                }

                if (file.size > MAX_SIZE) {
                    return "The PDF file must not exceed 10 MB.";
                }

                try {

                    const sampleBuffer =
                        await file.slice(0, 1028).arrayBuffer();

                    const sample =
                        new Uint8Array(sampleBuffer);

                    const signature = [
                        0x25,
                        0x50,
                        0x44,
                        0x46,
                        0x2D
                    ];

                    let signatureFound = false;

                    for (
                        let i = 0;
                        i <= sample.length - signature.length;
                        i++
                    ) {

                        let matches = true;

                        for (
                            let j = 0;
                            j < signature.length;
                            j++
                        ) {

                            if (sample[i + j] !== signature[j]) {
                                matches = false;
                                break;
                            }
                        }

                        if (matches) {
                            signatureFound = true;
                            break;
                        }
                    }

                    if (!signatureFound) {
                        return "The selected file is not recognised as a PDF. Please choose a genuine PDF document.";
                    }

                } catch (error) {

                    return "The browser could not read the selected document. Please try selecting it again.";
                }

                return "";
            }

            // ==================================================
            // SIGNER HELPERS
            // ==================================================

            function getSignerCards() {

                return Array.from(
                    signersContainer.querySelectorAll(".signer-card")
                );
            }

            function signerIsComplete(card) {

                const name =
                    card.querySelector(".signer-name");

                const email =
                    card.querySelector(".signer-email");

                const signature =
                    card.querySelector(".signer-signature-anchor");

                const nameAnchor =
                    card.querySelector(".signer-name-anchor");

                const dateAnchor =
                    card.querySelector(".signer-date-anchor");

                // Date to Prefill is optional.
                // Date Field Anchor Text remains mandatory.

                return hasValue(name) &&
                    hasValue(email) &&
                    email.validity.valid &&
                    hasValue(signature) &&
                    hasValue(nameAnchor) &&
                    hasValue(dateAnchor);
            }

            function allSignersComplete() {

                const cards = getSignerCards();

                if (cards.length < 1 || cards.length > MAX_SIGNERS) {
                    return false;
                }

                const emails = cards.map(function (card) {

                    return valueOf(
                        card.querySelector(".signer-email")
                    ).toLowerCase();

                });

                const uniqueEmails = new Set(emails);

                if (uniqueEmails.size !== emails.length) {
                    return false;
                }

                return cards.every(signerIsComplete);
            }

            // ==================================================
            // FORM COMPLETION HELPERS
            // ==================================================

            function documentDetailsComplete() {

                return hasValue(requestDate) &&
                    hasValue(documentType) &&
                    hasValue(recipientCompany) &&
                    hasValue(recipientEmail) &&
                    recipientEmail.validity.valid;
            }

            function invitationDetailsComplete() {
                return hasValue(emailSubject);
            }

            function adobeSignDetailsComplete() {

                const validSigningOrder =
                    signingOrder &&
                    (
                        signingOrder.value === "Sequential" ||
                        signingOrder.value === "Parallel"
                    );

                return validSigningOrder && allSignersComplete();
            }

            // ==================================================
            // PROGRESS INDICATOR
            // ==================================================

            function updateProgress() {

                const completed = [
                    validPdfSelected(),
                    documentDetailsComplete(),
                    invitationDetailsComplete(),
                    adobeSignDetailsComplete()
                ];

                let activeStep = completed.findIndex(function (done) {
                    return !done;
                });

                if (activeStep === -1) {
                    activeStep = 4;
                }

                steps.forEach(function (step, index) {

                    if (!step) {
                        return;
                    }

                    step.classList.remove("active", "completed");

                    step.removeAttribute("aria-current");

                    const number =
                        step.querySelector(".sp-step-number");

                    if (index < activeStep) {

                        step.classList.add("completed");

                        if (number) {
                            number.textContent = "✓";
                        }

                    } else if (index === activeStep) {

                        step.classList.add("active");

                        step.setAttribute("aria-current", "step");

                        if (number) {
                            number.textContent = String(index + 1);
                        }

                    } else {

                        if (number) {
                            number.textContent = String(index + 1);
                        }
                    }
                });
            }

            function showReviewAndSendProgress() {

                steps.forEach(function (step, index) {

                    if (!step) {
                        return;
                    }

                    step.classList.remove("active", "completed");

                    step.removeAttribute("aria-current");

                    const number =
                        step.querySelector(".sp-step-number");

                    if (index < 4) {

                        step.classList.add("completed");

                        if (number) {
                            number.textContent = "✓";
                        }

                    } else if (index === 4) {

                        step.classList.add("active");

                        step.setAttribute("aria-current", "step");

                        if (number) {
                            number.textContent = "5";
                        }
                    }
                });
            }

            // ==================================================
            // UPLOAD DISPLAY HELPERS
            // ==================================================

            function showFileError(message) {

                fileError.textContent = message;

                uploadZone.classList.add("upload-invalid");
            }

            function clearFileError() {

                fileError.textContent = "";

                uploadZone.classList.remove("upload-invalid");
            }

            function restorePendingUploadDisplay() {

                if (!hasPendingUpload()) {
                    return false;
                }

                const fileName =
                    pendingUploadFileName.value.trim();

                selectedFileIsValidPdf = true;

                selectedFileName.textContent = fileName;

                reviewFile.textContent = fileName;

                selectedFile.style.display = "flex";

                return true;
            }

            function clearFileDisplay() {

                if (restorePendingUploadDisplay()) {
                    updateProgress();
                    return;
                }

                selectedFileIsValidPdf = false;

                selectedFile.style.display = "none";

                selectedFileName.textContent = "";

                reviewFile.textContent = "No document selected";

                updateProgress();
            }

            function updateFileDisplay(file) {

                if (!file) {
                    return;
                }

                selectedFileIsValidPdf = true;

                clearFileError();

                selectedFileName.textContent = file.name;

                reviewFile.textContent = file.name;

                selectedFile.style.display = "flex";

                updateProgress();
            }

            // ==================================================
            // PROCESS SELECTED PDF
            // ==================================================

            async function processFile(file) {

                const currentVersion = ++fileValidationVersion;

                if (!file) {

                    selectedFileIsValidPdf = false;

                    clearFileDisplay();

                    return false;
                }

                clearFileError();

                const validationError =
                    await getPdfValidationError(file);

                if (currentVersion !== fileValidationVersion) {
                    return false;
                }

                if (validationError) {

                    selectedFileIsValidPdf = false;

                    showFileError(validationError);

                    if (
                        fileInput.files &&
                        fileInput.files.length > 0 &&
                        fileInput.files[0] === file
                    ) {
                        fileInput.value = "";
                    }

                    clearFileDisplay();

                    return false;
                }

                updateFileDisplay(file);

                return true;
            }

            // ==================================================
            // REINDEX SIGNER FIELDS
            // ==================================================

            function reindexSignerCards() {

                const cards = getSignerCards();

                cards.forEach(function (card, index) {

                    card.dataset.signerIndex = String(index);

                    const heading =
                        card.querySelector(".signer-card-header h6");

                    if (heading) {

                        heading.innerHTML =
                            '<span class="signer-number">' +
                            (index + 1) +
                            '</span> Signer ' +
                            (index + 1);
                    }

                    const fields = [
                        {
                            selector: ".signer-name",
                            suffix: "Name"
                        },
                        {
                            selector: ".signer-email",
                            suffix: "Email"
                        },
                        {
                            selector: ".signer-signature-anchor",
                            suffix: "SignatureAnchorText"
                        },
                        {
                            selector: ".signer-name-anchor",
                            suffix: "NameAnchorText"
                        },
                        {
                            selector: ".signer-date-anchor",
                            suffix: "DateAnchorText"
                        },
                        {
                            selector: ".signer-date-value",
                            suffix: "DateFieldValue"
                        }
                    ];

                    fields.forEach(function (field) {

                        const input =
                            card.querySelector(field.selector);

                        if (!input) {
                            return;
                        }

                        input.name =
                            "Signers[" + index + "]." + field.suffix;

                        input.id =
                            "Signers_" + index + "__" + field.suffix;

                        const label = card.querySelector(
                            'label[for^="Signers_"][for$="__' +
                            field.suffix +
                            '"]'
                        );

                        if (label) {
                            label.htmlFor = input.id;
                        }
                    });

                    const removeButton =
                        card.querySelector("[data-remove-signer]");

                    if (removeButton) {
                        removeButton.disabled = cards.length === 1;
                    }
                });

                signerCountSelect.value = String(cards.length);
            }

            // ==================================================
            // CREATE NEW SIGNER CARD
            // ==================================================

            function createSignerCard(index) {

                const html = signerTemplate.innerHTML
                    .replaceAll("__INDEX__", String(index))
                    .replaceAll("__NUMBER__", String(index + 1));

                const temporary =
                    document.createElement("div");

                temporary.innerHTML = html.trim();

                return temporary.firstElementChild;
            }

            // ==================================================
            // REVIEW SUMMARY
            // ==================================================

            function updateReview() {

                reviewDate.textContent =
                    valueOf(requestDate) || "Not entered";

                reviewType.textContent =
                    valueOf(documentType) || "Not entered";

                reviewCompany.textContent =
                    valueOf(recipientCompany) || "Not entered";

                reviewRecipientEmail.textContent =
                    valueOf(recipientEmail) || "Not entered";

                reviewSubject.textContent =
                    valueOf(emailSubject) || "Not entered";

                const cards = getSignerCards();

                reviewSignerCount.textContent =
                    String(cards.length);

                reviewSigningOrder.textContent =
                    signingOrder.value === "Parallel"
                        ? "Parallel"
                        : "Sequential";

                reviewSigners.innerHTML = "";

                cards.forEach(function (card, index) {

                    const name =
                        valueOf(card.querySelector(".signer-name"));

                    const email =
                        valueOf(card.querySelector(".signer-email"));

                    const signature =
                        valueOf(card.querySelector(".signer-signature-anchor"));

                    const nameAnchor =
                        valueOf(card.querySelector(".signer-name-anchor"));

                    const dateAnchor =
                        valueOf(card.querySelector(".signer-date-anchor"));

                    const dateValue =
                        valueOf(card.querySelector(".signer-date-value"));

                    const reviewCard =
                        document.createElement("div");

                    reviewCard.className = "review-signer";

                    const heading =
                        document.createElement("h6");

                    heading.textContent =
                        "Signer " + (index + 1);

                    reviewCard.appendChild(heading);

                    function addReviewLine(label, value) {

                        const paragraph =
                            document.createElement("p");

                        const strong =
                            document.createElement("strong");

                        const span =
                            document.createElement("span");

                        strong.textContent = label + ": ";

                        span.textContent = value || "Not entered";

                        paragraph.appendChild(strong);

                        paragraph.appendChild(span);

                        reviewCard.appendChild(paragraph);
                    }

                    addReviewLine("Name", name);

                    addReviewLine("Email", email);

                    addReviewLine("Signature anchor", signature);

                    addReviewLine("Name anchor", nameAnchor);

                    addReviewLine("Date anchor", dateAnchor);

                    addReviewLine(
                        "Date to prefill",
                        dateValue || "Not selected"
                    );

                    reviewSigners.appendChild(reviewCard);
                });
            }

            function updateAll() {

                updateReview();

                updateProgress();
            }

            // ==================================================
            // SIGNER COUNT
            // ==================================================

            function setSignerCount(count) {

                count = Math.max(
                    1,
                    Math.min(MAX_SIGNERS, count)
                );

                let cards = getSignerCards();

                while (cards.length < count) {

                    const newCard =
                        createSignerCard(cards.length);

                    signersContainer.appendChild(newCard);

                    cards = getSignerCards();
                }

                while (cards.length > count) {

                    cards[cards.length - 1].remove();

                    cards = getSignerCards();
                }

                reindexSignerCards();

                updateAll();
            }

            // ==================================================
            // OPEN FILE PICKER
            // ==================================================

            browseButton.addEventListener("click", function () {
                fileInput.click();
            });

            // ==================================================
            // FILE SELECTION
            // ==================================================

            fileInput.addEventListener("change", async function () {

                clearFileError();

                const file =
                    this.files && this.files.length > 0
                        ? this.files[0]
                        : null;

                await processFile(file);
            });

            // ==================================================
            // DRAG AND DROP
            // ==================================================

            uploadZone.addEventListener("dragover", function (event) {

                event.preventDefault();

                uploadZone.classList.add("drag-over");
            });

            uploadZone.addEventListener("dragleave", function (event) {

                if (!uploadZone.contains(event.relatedTarget)) {
                    uploadZone.classList.remove("drag-over");
                }
            });

            uploadZone.addEventListener("drop", async function (event) {

                event.preventDefault();

                uploadZone.classList.remove("drag-over");

                const files = event.dataTransfer.files;

                if (!files || files.length === 0) {
                    return;
                }

                const file = files[0];

                const validationError =
                    await getPdfValidationError(file);

                if (validationError) {

                    showFileError(validationError);

                    return;
                }

                try {

                    const dataTransfer = new DataTransfer();

                    dataTransfer.items.add(file);

                    fileInput.files = dataTransfer.files;

                    await processFile(file);

                } catch (error) {

                    selectedFileIsValidPdf = false;

                    showFileError(
                        "Your browser could not attach the dropped file. Please use Browse for Documents."
                    );
                }
            });

            // ==================================================
            // CHANGE SIGNER COUNT
            // ==================================================

            signerCountSelect.addEventListener("change", function () {

                setSignerCount(
                    parseInt(this.value, 10)
                );
            });

            // ==================================================
            // REMOVE SIGNER
            // ==================================================

            signersContainer.addEventListener("click", function (event) {

                const target = event.target;

                if (!(target instanceof Element)) {
                    return;
                }

                const removeButton =
                    target.closest("[data-remove-signer]");

                if (!removeButton || removeButton.disabled) {
                    return;
                }

                const card =
                    removeButton.closest(".signer-card");

                if (card) {

                    card.remove();

                    reindexSignerCards();

                    updateAll();
                }
            });

            // ==================================================
            // LIVE REVIEW AND PROGRESS UPDATES
            // ==================================================

            form.addEventListener("input", function (event) {

                if (event.target.matches("input, textarea, select")) {
                    updateAll();
                }
            });

            form.addEventListener("change", function () {
                updateAll();
            });

            // ==================================================
            // FORM SUBMISSION VALIDATION
            // ==================================================

            form.addEventListener("submit", function (event) {

                clearFileError();

                if (!validPdfSelected()) {

                    event.preventDefault();

                    showFileError(
                        "Please upload a valid PDF document before continuing."
                    );

                    uploadZone.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    browseButton.focus();

                    return;
                }

                const cards = getSignerCards();

                if (cards.length < 1 || cards.length > MAX_SIGNERS) {

                    event.preventDefault();

                    alert("Please select between 1 and 10 signers.");

                    signerCountSelect.focus();

                    return;
                }

                if (
                    !hasValue(recipientEmail) ||
                    !recipientEmail.validity.valid
                ) {

                    event.preventDefault();

                    alert("Please enter a valid recipient email address.");

                    recipientEmail.focus();

                    recipientEmail.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return;
                }

                const seenEmails = new Set();

                for (let index = 0; index < cards.length; index++) {

                    const card = cards[index];

                    const requiredFields = [
                        {
                            selector: ".signer-name",
                            label: "full name"
                        },
                        {
                            selector: ".signer-email",
                            label: "email address"
                        },
                        {
                            selector: ".signer-signature-anchor",
                            label: "signature anchor text"
                        },
                        {
                            selector: ".signer-name-anchor",
                            label: "name anchor text"
                        },
                        {
                            selector: ".signer-date-anchor",
                            label: "date anchor text"
                        }
                    ];

                    for (const field of requiredFields) {

                        const input =
                            card.querySelector(field.selector);

                        if (
                            !hasValue(input) ||
                            !input.validity.valid
                        ) {

                            event.preventDefault();

                            alert(
                                "Please enter a valid " +
                                field.label +
                                " for signer " +
                                (index + 1) +
                                "."
                            );

                            input.focus();

                            input.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });

                            return;
                        }
                    }

                    // DateFieldValue is optional.
                    // If the user selects a date, it must be a valid date input.

                    const dateValueInput =
                        card.querySelector(".signer-date-value");

                    if (
                        dateValueInput.value &&
                        !dateValueInput.validity.valid
                    ) {

                        event.preventDefault();

                        alert(
                            "Please select a valid prefill date for signer " +
                            (index + 1) +
                            "."
                        );

                        dateValueInput.focus();

                        return;
                    }

                    const email =
                        valueOf(
                            card.querySelector(".signer-email")
                        ).toLowerCase();

                    if (seenEmails.has(email)) {

                        event.preventDefault();

                        alert(
                            "Each signer must have a unique email address. " +
                            "The email for signer " +
                            (index + 1) +
                            " is already being used."
                        );

                        card.querySelector(".signer-email").focus();

                        return;
                    }

                    seenEmails.add(email);
                }

                if (
                    !signingOrder ||
                    (
                        signingOrder.value !== "Sequential" &&
                        signingOrder.value !== "Parallel"
                    )
                ) {

                    event.preventDefault();

                    alert("Please select a valid signing order.");

                    signingOrder.focus();

                    return;
                }

                if (!form.checkValidity()) {

                    event.preventDefault();

                    form.reportValidity();

                    return;
                }

                showReviewAndSendProgress();

                const submitButton =
                    document.getElementById("submitSigningButton");

                submitButton.disabled = true;

                submitButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>' +
                    'Preparing Adobe Sign agreement...';
            });

            // ==================================================
            // INITIAL PAGE SETUP
            // ==================================================

            reindexSignerCards();

            if (hasPendingUpload()) {
                restorePendingUploadDisplay();
            }

            updateAll();

        });
    </script>
}