@page
@model DocuWareAdobeSignIntegration.Pages.Signing.SendForSignatureModel

@{
    ViewData["Title"] = "Send for Signature";

    var initialSignerCount = Math.Clamp(Model.Signers?.Count ?? 1, 1, 10);

    var hasPendingUpload =
        !string.IsNullOrWhiteSpace(Model.PendingUploadToken) &&
        !string.IsNullOrWhiteSpace(Model.PendingUploadFileName);
}

<style>
    .signing-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
    }

        .signing-page .signing-header {
            margin-bottom: 22px;
        }

            .signing-page .signing-header h2 {
                margin-bottom: 8px;
                color: #fff;
            }

            .signing-page .signing-header p {
                margin-bottom: 0;
                color: #a3a8bd;
            }

        .signing-page .sp-steps {
            width: 100%;
            padding: 24px;
            margin-bottom: 20px;
        }

        .signing-page .sp-steps-title {
            font-size: 15px;
            font-weight: 650;
            margin-bottom: 22px;
            color: #fff;
        }

        .signing-page .sp-steps-list {
            display: grid !important;
            grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
            align-items: start;
            gap: 14px;
            width: 100%;
        }

        .signing-page .sp-step {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 9px;
            min-width: 0;
            text-align: center;
        }

        .signing-page .sp-step-number {
            display: flex !important;
            align-items: center;
            justify-content: center;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            border: 1px solid rgba(255,255,255,.20);
            border-radius: 50%;
            background: rgba(255,255,255,.07);
            color: #c4c7d6;
            font-size: 14px;
            font-weight: 700;
            transition: all .3s ease;
        }

        .signing-page .sp-step-label {
            display: block;
            max-width: 100%;
            color: #a3a8bd;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .signing-page .sp-step.active .sp-step-number {
            background: rgba(155,123,255,.24);
            border-color: #9b7bff;
            color: #d5c7ff;
            box-shadow: 0 0 0 5px rgba(155,123,255,.10), 0 0 20px rgba(155,123,255,.15);
        }

        .signing-page .sp-step.active .sp-step-label {
            color: #c9b8ff;
        }

        .signing-page .sp-step.completed .sp-step-number {
            background: rgba(46,204,143,.17);
            border-color: rgba(46,204,143,.65);
            color: #86efac;
        }

        .signing-page .sp-step.completed .sp-step-label {
            color: #86efac;
        }

        .signing-page .signing-card {
            width: 100%;
            min-width: 0;
            padding: 26px;
        }

            .signing-page .signing-card section {
                width: 100%;
                min-width: 0;
            }

        .signing-page .sp-heading {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 22px;
        }

            .signing-page .sp-heading h4 {
                margin: 0 0 6px;
                color: #fff;
                font-size: 18px;
                font-weight: 650;
            }

            .signing-page .sp-heading p {
                margin: 0;
                color: #a3a8bd;
                font-size: 13px;
            }

        .signing-page .sp-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            border: 1px solid rgba(155,123,255,.22);
            border-radius: 12px;
            background: rgba(155,123,255,.12);
            color: #c9b8ff;
            font-size: 19px;
        }

        .signing-page .upload-zone {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            gap: 11px;
            position: relative;
            width: 100%;
            min-height: 205px;
            padding: 26px;
            border: 1px dashed rgba(167,139,250,.48);
            border-radius: 16px;
            background: rgba(255,255,255,.035);
            cursor: default;
            transition: background .25s ease, border-color .25s ease, box-shadow .25s ease;
        }

            .signing-page .upload-zone:hover,
            .signing-page .upload-zone.drag-over {
                border-color: #a78bfa;
                background: rgba(139,92,246,.09);
                box-shadow: inset 0 0 25px rgba(139,92,246,.05);
            }

        .signing-page .upload-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            border: 1px solid rgba(155,123,255,.25);
            border-radius: 14px;
            background: rgba(155,123,255,.13);
            color: #c9b8ff;
            font-size: 24px;
        }

        .signing-page .upload-zone h5 {
            margin: 0;
            color: #fff;
            font-size: 16px;
            font-weight: 650;
        }

        .signing-page .upload-zone p {
            margin: 0;
            color: #a3a8bd;
            font-size: 13px;
        }

        .signing-page .upload-zone input[type="file"] {
            display: none !important;
        }

        .signing-page .upload-browse-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: 5px;
            padding: 10px 17px;
            border-radius: 11px;
            color: #c9b8ff;
            background: rgba(155,123,255,.09);
            border: 1px solid rgba(155,123,255,.45);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background .25s ease, border-color .25s ease, transform .25s ease;
        }

            .signing-page .upload-browse-btn:hover {
                color: #fff;
                background: rgba(155,123,255,.22);
                border-color: #9b7bff;
                transform: translateY(-2px);
            }

        .signing-page .selected-file {
            display: none;
            align-items: center;
            gap: 10px;
            width: 100%;
            margin-top: 14px;
            padding: 13px 16px;
            border: 1px solid rgba(46,204,143,.30);
            border-radius: 12px;
            background: rgba(46,204,143,.08);
            color: #8ee8c4;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

            .signing-page .selected-file i {
                flex-shrink: 0;
                font-size: 19px;
            }

        .signing-page #selectedFileName {
            overflow-wrap: anywhere;
        }

        .signing-page .upload-help,
        .signing-page .anchor-help {
            display: block;
            margin-top: 8px;
            color: #a3a8bd;
            font-size: 12px;
            line-height: 1.6;
        }

        .signing-page .file-error {
            display: block;
            margin-top: 8px;
            color: #ff8a95;
            font-size: 12px;
        }

        .signing-page .upload-zone.upload-invalid {
            border-color: rgba(255,93,108,.8);
            background: rgba(255,93,108,.06);
        }

        .signing-page .sp-divider {
            width: 100%;
            margin: 30px 0;
            border: 0;
            border-top: 1px solid rgba(255,255,255,.12);
            opacity: 1;
        }

        .signing-page .form-label {
            color: #c4c7d6;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .signing-page .form-control,
        .signing-page .form-select {
            width: 100%;
            min-width: 0;
            color: #f3f4f8;
            background-color: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
            padding: 11px 13px;
            font-size: 13px;
        }

            .signing-page .form-control:focus,
            .signing-page .form-select:focus {
                color: #fff;
                background-color: rgba(255,255,255,.08);
                border-color: rgba(155,123,255,.75);
                box-shadow: 0 0 0 3px rgba(155,123,255,.15);
            }

            .signing-page .form-control::placeholder {
                color: #858ba0;
            }

            .signing-page .form-select option {
                color: #222;
                background: #fff;
            }

        .signing-page input[type="date"].form-control {
            color-scheme: dark;
            min-height: 43px;
            cursor: pointer;
        }

            .signing-page input[type="date"].form-control::-webkit-calendar-picker-indicator {
                cursor: pointer;
                filter: invert(1);
                opacity: .8;
            }

        .signing-page textarea.form-control {
            resize: vertical;
            min-height: 110px;
        }

        .signing-page .adobe-panel {
            width: 100%;
            padding: 20px;
            border: 1px solid rgba(155,123,255,.22);
            border-radius: 15px;
            background: rgba(155,123,255,.055);
        }

            .signing-page .adobe-panel h5 {
                margin: 0 0 8px;
                color: #fff;
                font-size: 15px;
                font-weight: 650;
            }

            .signing-page .adobe-panel > p {
                margin: 0 0 18px;
                color: #a3a8bd;
                font-size: 12px;
                line-height: 1.6;
            }

        .signing-page .signer-card {
            width: 100%;
            margin-bottom: 16px;
            padding: 19px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 14px;
            background: rgba(255,255,255,.035);
        }

            .signing-page .signer-card:last-child {
                margin-bottom: 0;
            }

        .signing-page .signer-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 18px;
        }

            .signing-page .signer-card-header h6 {
                margin: 0;
                color: #fff;
                font-size: 14px;
                font-weight: 700;
            }

        .signing-page .signer-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 27px;
            height: 27px;
            margin-right: 8px;
            border-radius: 8px;
            color: #d5c7ff;
            background: rgba(155,123,255,.17);
        }

        .signing-page .signer-remove {
            color: #ff9ba4;
            background: rgba(255,93,108,.08);
            border: 1px solid rgba(255,93,108,.25);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            cursor: pointer;
        }

            .signing-page .signer-remove:hover {
                background: rgba(255,93,108,.17);
            }

            .signing-page .signer-remove:disabled {
                opacity: .35;
                cursor: not-allowed;
            }

        .signing-page .date-value-panel {
            padding: 13px;
            border: 1px solid rgba(155,123,255,.18);
            border-radius: 12px;
            background: rgba(155,123,255,.045);
        }

            .signing-page .date-value-panel .form-label {
                color: #d5c7ff;
            }

        .signing-page .review-panel {
            width: 100%;
            padding: 22px;
            border: 1px solid rgba(255,255,255,.13);
            border-radius: 16px;
            background: rgba(255,255,255,.045);
        }

            .signing-page .review-panel h6 {
                margin: 0 0 15px;
                color: #fff;
                font-size: 15px;
                font-weight: 700;
            }

        .signing-page .review-row {
            display: grid;
            grid-template-columns: minmax(120px, .75fr) minmax(0, 1.25fr);
            align-items: center;
            gap: 16px;
            width: 100%;
            padding: 13px 0;
            border-bottom: 1px solid rgba(255,255,255,.09);
        }

            .signing-page .review-row:last-child {
                border-bottom: 0;
            }

            .signing-page .review-row span:first-child {
                color: #a3a8bd;
                font-size: 13px;
                font-weight: 600;
            }

            .signing-page .review-row span:last-child {
                min-width: 0;
                color: #f3f4f8;
                font-size: 13px;
                text-align: right;
                overflow-wrap: anywhere;
            }

        .signing-page .review-signer {
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,.09);
        }

            .signing-page .review-signer:last-child {
                border-bottom: 0;
            }

            .signing-page .review-signer h6 {
                margin-bottom: 10px;
                color: #c9b8ff;
            }

            .signing-page .review-signer p {
                margin: 5px 0;
                color: #f3f4f8;
                font-size: 13px;
                overflow-wrap: anywhere;
            }

            .signing-page .review-signer strong {
                color: #a3a8bd;
                font-weight: 600;
            }

        .signing-page .form-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,.10);
        }

            .signing-page .form-actions .btn {
                min-height: 42px;
                padding: 10px 19px;
                font-weight: 600;
            }

            .signing-page .form-actions .btn-primary {
                color: #fff;
                background: linear-gradient(135deg, #7b6bff, #4c8dff);
                border: 0;
            }

                .signing-page .form-actions .btn-primary:disabled {
                    opacity: .7;
                    cursor: wait;
                }

        .signing-page .text-danger,
        .signing-page .field-validation-error {
            color: #ff8a95 !important;
            font-size: 12px;
        }

        .signing-page .alert {
            border-radius: 13px;
        }

        .signing-page .sender-note {
            margin-top: 14px;
            padding: 12px 14px;
            border: 1px solid rgba(46,204,143,.2);
            border-radius: 10px;
            background: rgba(46,204,143,.06);
            color: #a6e9cf;
            font-size: 12px;
            line-height: 1.6;
        }

    @@media (max-width: 760px) {
        .signing-page .sp-steps-list {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            row-gap: 22px;
        }

        .signing-page .signing-card {
            padding: 18px;
        }

        .signing-page .sp-steps {
            padding: 19px;
        }

        .signing-page .review-row {
            grid-template-columns: 1fr;
            gap: 5px;
            align-items: start;
        }

            .signing-page .review-row span:last-child {
                text-align: left;
            }
    }

    @@media (max-width: 420px) {
        .signing-page .sp-steps-list {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .signing-page .upload-zone {
            padding: 19px;
        }

        .signing-page .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .signing-page .form-actions .btn {
                width: 100%;
            }

        .signing-page .signer-card {
            padding: 14px;
        }
    }
</style>

<div class="signing-page">

    <div class="signing-header">
        <h2>Create a signing request</h2>
        <p>
            Upload your document, add one or more signers and prepare
            your Adobe Acrobat Sign agreement.
        </p>
    </div>

    <!-- FIVE-STEP PROGRESS INDICATOR -->

    <div class="content-panel sp-steps">

        <div class="sp-steps-title">Signing process</div>

        <div class="sp-steps-list">

            <div class="sp-step active" id="progressStep1">
                <div class="sp-step-number">1</div>
                <div class="sp-step-label">Upload PDF</div>
            </div>

            <div class="sp-step" id="progressStep2">
                <div class="sp-step-number">2</div>
                <div class="sp-step-label">Document Details</div>
            </div>

            <div class="sp-step" id="progressStep3">
                <div class="sp-step-number">3</div>
                <div class="sp-step-label">Invitation Details</div>
            </div>

            <div class="sp-step" id="progressStep4">
                <div class="sp-step-number">4</div>
                <div class="sp-step-label">Adobe Sign</div>
            </div>

            <div class="sp-step" id="progressStep5">
                <div class="sp-step-number">5</div>
                <div class="sp-step-label">Review and Send</div>
            </div>

        </div>
    </div>

    <div class="content-panel signing-card">

        <form id="signingForm"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="PendingUploadToken"
                   name="PendingUploadToken"
                   value="@Model.PendingUploadToken" />

            <input type="hidden"
                   id="PendingUploadFileName"
                   name="PendingUploadFileName"
                   value="@Model.PendingUploadFileName" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <!-- STEP 1: UPLOAD PDF -->

            <section id="uploadSection">

                <div class="sp-heading">

                    <div class="sp-icon">
                        <i class="bi bi-cloud-arrow-up"></i>
                    </div>

                    <div>
                        <h4>1. Upload PDF</h4>
                        <p>
                            Choose the document you want to send for signature.
                        </p>
                    </div>

                </div>

                <div class="upload-zone" id="uploadZone">

                    <div class="upload-icon">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>

                    <h5>Drag and drop your PDF here</h5>

                    <p>Or browse your computer to select a document.</p>

                    <button type="button"
                            class="upload-browse-btn"
                            id="chooseFileButton">

                        <i class="bi bi-folder2-open"></i>
                        Browse for Documents

                    </button>

                    <input asp-for="UploadedFile"
                           type="file"
                           hidden
                           aria-label="Choose a PDF document" />

                </div>

                <div class="selected-file"
                     id="selectedFile"
                     style="@(hasPendingUpload ? "display:flex;" : "display:none;")">

                    <i class="bi bi-file-earmark-pdf"></i>

                    <span id="selectedFileName">
                        @(hasPendingUpload ? Model.PendingUploadFileName : "")
                    </span>

                </div>

                <span id="fileError"
                      class="file-error"
                      role="alert"></span>

                <span asp-validation-for="UploadedFile"
                      class="text-danger"></span>

                <small class="upload-help">
                    Any valid PDF document is accepted, including scanned
                    and image-based PDFs. Maximum file size: 10 MB.
                    The original unsigned document will be uploaded to
                    DocuWare before the Adobe Sign agreement is created.
                </small>

            </section>

            <hr class="sp-divider" />

            <!-- STEP 2: DOCUMENT DETAILS -->

            <section id="documentDetailsSection">

                <div class="sp-heading">

                    <div class="sp-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <div>
                        <h4>2. Document Details</h4>
                        <p>
                            Enter the document information and recipient contact details.
                        </p>
                    </div>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="RequestDate" class="form-label">
                            Request Date <span class="text-danger">*</span>
                        </label>

                        <input asp-for="RequestDate"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="RequestDate"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="DocumentType" class="form-label">
                            Document Type <span class="text-danger">*</span>
                        </label>

                        <input asp-for="DocumentType"
                               class="form-control"
                               placeholder="Enter document type"
                               required />

                        <span asp-validation-for="DocumentType"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="RecipientCompany" class="form-label">
                            Recipient Company <span class="text-danger">*</span>
                        </label>

                        <input asp-for="RecipientCompany"
                               class="form-control"
                               placeholder="Enter the recipient's company"
                               required />

                        <span asp-validation-for="RecipientCompany"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="RecipientEmail" class="form-label">
                            Recipient Email Address <span class="text-danger">*</span>
                        </label>

                        <input asp-for="RecipientEmail"
                               type="email"
                               class="form-control"
                               maxlength="320"
                               placeholder="contact@example.com"
                               required />

                        <span asp-validation-for="RecipientEmail"
                              class="text-danger"></span>

                        <small class="anchor-help">
                            Contact email associated with the recipient company.
                            Signing invitations are sent to the signer email
                            addresses configured in the Adobe Sign step.
                        </small>

                    </div>

                </div>

            </section>

            <hr class="sp-divider" />

            <!-- STEP 3: INVITATION DETAILS -->

            <section id="invitationDetailsSection">

                <div class="sp-heading">

                    <div class="sp-icon">
                        <i class="bi bi-envelope-paper"></i>
                    </div>

                    <div>
                        <h4>3. Invitation Details</h4>
                        <p>
                            Customise the email that Adobe Sign will send
                            to the signers.
                        </p>
                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="EmailSubject" class="form-label">
                        Email Subject <span class="text-danger">*</span>
                    </label>

                    <input asp-for="EmailSubject"
                           class="form-control"
                           placeholder="Enter email subject"
                           required />

                    <span asp-validation-for="EmailSubject"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Message" class="form-label">
                        Message to Signers
                    </label>

                    <textarea asp-for="Message"
                              class="form-control"
                              rows="4"
                              placeholder="Enter a message or instructions for the signers..."></textarea>

                    <span asp-validation-for="Message"
                          class="text-danger"></span>

                </div>

            </section>

            <hr class="sp-divider" />

            <!-- STEP 4: ADOBE SIGN CONFIGURATION -->

            <section id="adobeSignSection">

                <div class="sp-heading">

                    <div class="sp-icon">
                        <i class="bi bi-pen"></i>
                    </div>

                    <div>
                        <h4>4. Adobe Sign</h4>
                        <p>
                            Configure your signers, signing order and automatic
                            signature field placement.
                        </p>
                    </div>

                </div>

                <div class="adobe-panel">

                    <h5>
                        <i class="bi bi-pen me-2"></i>
                        Adobe Acrobat Sign — Signer Configuration
                    </h5>

                    <p>
                        Add the people who must sign this document.
                        The account user creating this request is the sender
                        and is not automatically added as a signer.
                    </p>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <label for="signerCount" class="form-label">
                                Number of Signers <span class="text-danger">*</span>
                            </label>

                            <select id="signerCount"
                                    name="SignerCount"
                                    class="form-select">

                                @for (var i = 1; i <= 10; i++)
                                {
                                    if (i == initialSignerCount)
                                    {
                                        <option value="@i" selected>
                                            @i @(i == 1 ? "Signer" : "Signers")
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@i">
                                            @i @(i == 1 ? "Signer" : "Signers")
                                        </option>
                                    }
                                }

                            </select>

                            <small class="anchor-help">
                                You can add between 1 and 10 signers.
                            </small>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="SigningOrderMode" class="form-label">
                                Signing Order <span class="text-danger">*</span>
                            </label>

                            <select asp-for="SigningOrderMode"
                                    class="form-select"
                                    required>

                                <option value="Sequential">
                                    Sequential — one signer after another
                                </option>

                                <option value="Parallel">
                                    Parallel — all signers at the same time
                                </option>

                            </select>

                            <span asp-validation-for="SigningOrderMode"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div id="signersContainer">

                        @for (var i = 0; i < initialSignerCount; i++)
                        {
                            var signer = Model.Signers != null &&
                                         Model.Signers.Count > i
                                ? Model.Signers[i]
                                : new DocuWareAdobeSignIntegration.Pages.Signing.SignerFormInput();

                            <div class="signer-card" data-signer-index="@i">

                                <div class="signer-card-header">

                                    <h6>
                                        <span class="signer-number">@(i + 1)</span>
                                        Signer @(i + 1)
                                    </h6>

                                    <button type="button"
                                            class="signer-remove"
                                            data-remove-signer
                                        @(initialSignerCount == 1 ? "disabled" : null)>

                                        <i class="bi bi-trash me-1"></i>
                                        Remove

                                    </button>

                                </div>

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label"
                                               for="Signers_@(i)__Name">

                                            Full Name <span class="text-danger">*</span>

                                        </label>

                                        <input name="Signers[@i].Name"
                                               id="Signers_@(i)__Name"
                                               value="@signer.Name"
                                               class="form-control signer-name"
                                               type="text"
                                               maxlength="200"
                                               placeholder="Enter signer's full name"
                                               required />

                                        <span class="text-danger"
                                              data-valmsg-for="Signers[@i].Name"
                                              data-valmsg-replace="true"></span>

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label"
                                               for="Signers_@(i)__Email">

                                            Email Address <span class="text-danger">*</span>

                                        </label>

                                        <input name="Signers[@i].Email"
                                               id="Signers_@(i)__Email"
                                               value="@signer.Email"
                                               class="form-control signer-email"
                                               type="email"
                                               maxlength="320"
                                               placeholder="name@example.com"
                                               required />

                                        <span class="text-danger"
                                              data-valmsg-for="Signers[@i].Email"
                                              data-valmsg-replace="true"></span>

                                    </div>

                                </div>

                                <hr class="sp-divider" />

                                <h6 class="mb-3" style="color:#c9b8ff;">
                                    <i class="bi bi-crosshair me-2"></i>
                                    Automatic Field Placement
                                </h6>

                                <p class="anchor-help mb-3">
                                    Enter the exact text printed in the PDF beside
                                    each field. These anchors must exist in the
                                    uploaded document.
                                </p>

                                <div class="row g-3">

                                    <div class="col-md-12">

                                        <label class="form-label"
                                               for="Signers_@(i)__SignatureAnchorText">

                                            Signature Anchor Text
                                            <span class="text-danger">*</span>

                                        </label>

                                        <input name="Signers[@i].SignatureAnchorText"
                                               id="Signers_@(i)__SignatureAnchorText"
                                               value="@signer.SignatureAnchorText"
                                               class="form-control signer-signature-anchor"
                                               type="text"
                                               maxlength="150"
                                               placeholder="Example: SIGNER 1 SIGNATURE"
                                               required />

                                        <small class="anchor-help">
                                            Exact wording printed beside this
                                            signer's signature location.
                                        </small>

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label"
                                               for="Signers_@(i)__NameAnchorText">

                                            Name Anchor Text
                                            <span class="text-danger">*</span>

                                        </label>

                                        <input name="Signers[@i].NameAnchorText"
                                               id="Signers_@(i)__NameAnchorText"
                                               value="@signer.NameAnchorText"
                                               class="form-control signer-name-anchor"
                                               type="text"
                                               maxlength="150"
                                               placeholder="Example: SIGNER 1 NAME:"
                                               required />

                                        <small class="anchor-help">
                                            Exact wording printed beside the
                                            full-name field.
                                        </small>

                                    </div>

                                    <!-- DATE ANCHOR TEXT -->

                                    <div class="col-md-6">

                                        <label class="form-label"
                                               for="Signers_@(i)__DateAnchorText">

                                            <i class="bi bi-crosshair me-1"></i>
                                            Date Field Anchor Text
                                            <span class="text-danger">*</span>

                                        </label>

                                        <input name="Signers[@i].DateAnchorText"
                                               id="Signers_@(i)__DateAnchorText"
                                               value="@signer.DateAnchorText"
                                               class="form-control signer-date-anchor"
                                               type="text"
                                               maxlength="150"
                                               placeholder="Example: SIGNER 1 DATE:"
                                               required />

                                        <small class="anchor-help">
                                            Enter the exact date label printed in
                                            your PDF. Adobe uses this text to
                                            locate the date field.
                                        </small>

                                    </div>

                                    <!-- NEW DATE PICKER -->

                                    <div class="col-md-6">

                                        <div class="date-value-panel">

                                            <label class="form-label"
                                                   for="Signers_@(i)__DateFieldValue">

                                                <i class="bi bi-calendar-event me-1"></i>
                                                Date to Prefill
                                                <span class="text-muted">(Optional)</span>

                                            </label>

                                            <input name="Signers[@i].DateFieldValue"
                                                   id="Signers_@(i)__DateFieldValue"
                                                   value="@signer.DateFieldValue"
                                                   class="form-control signer-date-value"
                                                   type="date"
                                                   aria-label="Select a date to prefill for signer @(i + 1)" />

                                            <small class="anchor-help">
                                                Select a date to prefill in this
                                                signer's Adobe date field. Leave
                                                blank when the signer should enter
                                                the date themselves.
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <div class="sender-note">
                        <i class="bi bi-info-circle me-1"></i>

                        The sender will be redirected to Adobe Acrobat Sign to
                        review the prepared agreement. Signing invitations are
                        sent to the configured signers when the sender clicks
                        <strong>Send</strong> in Adobe.
                    </div>

                </div>

            </section>

            <hr class="sp-divider" />

            <!-- STEP 5: REVIEW AND SEND -->

            <section id="reviewSection">

                <div class="sp-heading">

                    <div class="sp-icon">
                        <i class="bi bi-check2-circle"></i>
                    </div>

                    <div>
                        <h4>5. Review and Send</h4>
                        <p>
                            Check your document, invitation details, signers
                            and field placement before continuing to Adobe Sign.
                        </p>
                    </div>

                </div>

                <div class="review-panel">

                    <h6>
                        <i class="bi bi-clipboard-check me-2"></i>
                        Request Summary
                    </h6>

                    <div class="review-row">
                        <span>PDF document</span>
                        <span id="reviewFile">
                            @(hasPendingUpload
                                ? Model.PendingUploadFileName
                                : "No document selected")
                        </span>
                    </div>

                    <div class="review-row">
                        <span>Request date</span>
                        <span id="reviewDate">
                            @(Model.RequestDate?.ToString("yyyy-MM-dd") ?? "Not entered")
                        </span>
                    </div>

                    <div class="review-row">
                        <span>Document type</span>
                        <span id="reviewType">
                            @(string.IsNullOrWhiteSpace(Model.DocumentType)
                                ? "Not entered"
                                : Model.DocumentType)
                        </span>
                    </div>

                    <div class="review-row">
                        <span>Recipient company</span>
                        <span id="reviewCompany">
                            @(string.IsNullOrWhiteSpace(Model.RecipientCompany)
                                ? "Not entered"
                                : Model.RecipientCompany)
                        </span>
                    </div>

                    <div class="review-row">
                        <span>Recipient email</span>
                        <span id="reviewRecipientEmail">
                            @(string.IsNullOrWhiteSpace(Model.RecipientEmail)
                                ? "Not entered"
                                : Model.RecipientEmail)
                        </span>
                    </div>

                    <div class="review-row">
                        <span>Number of signers</span>
                        <span id="reviewSignerCount">@initialSignerCount</span>
                    </div>

                    <div class="review-row">
                        <span>Signing order</span>
                        <span id="reviewSigningOrder">
                            @Model.SigningOrderMode
                        </span>
                    </div>

                    <div id="reviewSigners">

                        @for (var i = 0; i < initialSignerCount; i++)
                        {
                            var signer = Model.Signers != null &&
                                         Model.Signers.Count > i
                                ? Model.Signers[i]
                                : new DocuWareAdobeSignIntegration.Pages.Signing.SignerFormInput();

                            <div class="review-signer" data-review-signer="@i">

                                <h6>Signer @(i + 1)</h6>

                                <p>
                                    <strong>Name:</strong>
                                    <span class="review-signer-name">
                                        @(string.IsNullOrWhiteSpace(signer.Name)
                                            ? "Not entered"
                                            : signer.Name)
                                    </span>
                                </p>

                                <p>
                                    <strong>Email:</strong>
                                    <span class="review-signer-email">
                                        @(string.IsNullOrWhiteSpace(signer.Email)
                                            ? "Not entered"
                                            : signer.Email)
                                    </span>
                                </p>

                                <p>
                                    <strong>Signature anchor:</strong>
                                    <span class="review-signer-signature">
                                        @(string.IsNullOrWhiteSpace(signer.SignatureAnchorText)
                                            ? "Not entered"
                                            : signer.SignatureAnchorText)
                                    </span>
                                </p>

                                <p>
                                    <strong>Name anchor:</strong>
                                    <span class="review-signer-name-anchor">
                                        @(string.IsNullOrWhiteSpace(signer.NameAnchorText)
                                            ? "Not entered"
                                            : signer.NameAnchorText)
                                    </span>
                                </p>

                                <p>
                                    <strong>Date anchor:</strong>
                                    <span class="review-signer-date-anchor">
                                        @(string.IsNullOrWhiteSpace(signer.DateAnchorText)
                                            ? "Not entered"
                                            : signer.DateAnchorText)
                                    </span>
                                </p>

                                <p>
                                    <strong>Date to prefill:</strong>
                                    <span class="review-signer-date-value">
                                        @(string.IsNullOrWhiteSpace(signer.DateFieldValue)
                                            ? "Not selected"
                                            : signer.DateFieldValue)
                                    </span>
                                </p>

                            </div>
                        }

                    </div>

                    <div class="review-row">
                        <span>Email subject</span>
                        <span id="reviewSubject">
                            @(Model.EmailSubject ?? "Not entered")
                        </span>
                    </div>

                </div>

            </section>

            <!-- ERROR AND SUCCESS MESSAGES -->
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-warning mt-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    @Model.ErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="alert alert-success mt-3" role="status">
                    @Model.SuccessMessage
                </div>
            }

            <!-- FORM ACTIONS -->

            <div class="form-actions">

                <a asp-page="/Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary"
                        id="submitSigningButton">

                    <i class="bi bi-send me-1"></i>
                    Continue to Adobe Sign

                </button>

            </div>

        </form>

    </div>

</div>

